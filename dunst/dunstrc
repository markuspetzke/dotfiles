# dunst -- shared part; colors, border, font and format come from the active theme
# (dunstrc.d/50-theme.conf -> themes/<name>/dunst.conf).

[global]
    monitor = 0
    follow = mouse

    width = 360
    height = (0, 200)
    origin = top-right
    offset = (16, 16)
    gap_size = 8

    progress_bar = true
    progress_bar_height = 8

    transparency = 0
    separator_color = frame

    line_height = 2
    markup = full
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    # Papirus is not installed on this system; Adwaita is.
    icon_theme = Adwaita
    enable_recursive_icon_lookup = true

    sort = yes
    idle_threshold = 120
    notification_limit = 5
    indicate_hidden = yes
    sticky_history = yes
    history_length = 40

    dmenu = hyprlauncher -m
    # Own systemd unit: otherwise the browser inherits the limits of dunst.service.
    browser = uwsm-app -- xdg-open
    always_run_script = true

    # Mouse: left = action/close, middle = close all, right = close
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    timeout = 5

[urgency_normal]
    timeout = 8

[urgency_critical]
    timeout = 0
