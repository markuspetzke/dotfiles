# Git defaults from the dotfiles repo, valid on every machine.
# Name, mail and the SSH rewrite for GitHub are machine specific in ~/.gitconfig
# (read after this file, its values take precedence).

# pull without merge commits: rebase own commits onto the new state, stash changes briefly
[pull]
	rebase = true
[rebase]
	autoStash = true
# Also clean up branches deleted on the server
[fetch]
	prune = true
# The first push of a new branch creates it on the server
[push]
	autoSetupRemote = true
# More readable diffs; conflicts also show the common base version
[diff]
	algorithm = histogram
[merge]
	conflictStyle = zdiff3
[init]
	defaultBranch = main
