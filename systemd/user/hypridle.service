[Unit]
Description=Hyprland idle and power management
PartOf=hypr-session.target
After=hypr-session.target

[Service]
# No sandbox options: hypridle starts hyprlock, and hyprlock checks the password
# through the setuid program unix_chkpwd. In a user unit
# LockPersonality/RestrictSUIDSGID/RestrictRealtime imply NoNewPrivileges,
# and PrivateTmp/ProtectSystem/ProtectKernel*/ProtectControlGroups run in
# a user namespace -- both keep unix_chkpwd from reading /etc/shadow.
# The limits also apply to hyprlock.
ExecStart=%h/.config/hypr/scripts/run-hypridle.sh
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
MemoryMax=512M
TasksMax=256
