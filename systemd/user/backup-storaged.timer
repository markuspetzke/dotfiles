[Unit]
Description=Weekly backup ~/Documents -> storageD -> NAS

[Timer]
# Sunday before the Hetzner run (13:00): the current state is already on the NAS when
# it gets backed up to Hetzner. Weekly instead of monthly: rsync only transfers changes.
OnCalendar=Sun 11:00
# PC was off -> catch up at the next login
Persistent=true

[Install]
WantedBy=timers.target
