[Unit]
Description=Waybar panel
PartOf=hypr-session.target
After=hypr-session.target

[Service]
ExecStart=%h/.config/hypr/scripts/run-waybar.sh
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
MemoryMax=256M
TasksMax=256
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
# No ProtectKernelTunables/RestrictSUIDSGID: both block bwrap, which the
# glycin image loader of gdk-pixbuf uses -> tray icons (e.g. Steam) would be missing.
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
