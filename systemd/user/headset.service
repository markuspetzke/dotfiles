[Unit]
Description=Arctis 7: set sidetone and auto-off
PartOf=hypr-session.target
After=hypr-session.target
ConditionPathExists=/usr/bin/headsetcontrol

[Service]
Type=oneshot
# Desktop only; the headset is not used on the laptop.
ExecCondition=/usr/bin/sh -c '[ "$(%h/.config/hypr/scripts/hypr-profile.sh)" = desktop ]'
# Sidetone 0-128 (quiet), switch off after 30 minutes without sound.
# Fails silently if the headset is off at login.
ExecStart=-/usr/bin/headsetcontrol -s 32 -i 30
