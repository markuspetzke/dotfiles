[Unit]
Description=Backup NAS -> Hetzner (restic)
# Desktop only (GLaDOS). The timers are not enabled on the laptop anyway; this is the safeguard.
ConditionHost=GLaDOS
# Fails if the NAS does not wake up -> retry hourly, at most 6x a day
StartLimitIntervalSec=1d
StartLimitBurst=6

[Service]
Type=oneshot
# Progress once a minute in the journal (journalctl --user -u backup-hetzner -f)
Environment=RESTIC_PROGRESS_FPS=0.016666
# No sleep during the backup (otherwise the SFTP connection drops and restic hangs).
# Only "sleep": hypridle checks before suspending whether something blocks sleep
# (hypr/scripts/sleep-allowed.sh). Locking and monitors off keep working; "idle" would have
# silenced hypridle completely, even without locking for hours.
ExecStart=/usr/bin/systemd-inhibit --what=sleep --who=backup-hetzner --why="Backup NAS -> Hetzner running" %h/.local/bin/backup-hetzner
Restart=on-failure
RestartSec=1h
Nice=10
IOSchedulingClass=idle
