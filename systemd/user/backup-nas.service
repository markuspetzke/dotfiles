[Unit]
Description=Backup /mnt/storageD -> NAS
# Desktop only (GLaDOS). The timers are not enabled on the laptop anyway; this is the safeguard.
ConditionHost=GLaDOS
# During the day the script wakes the NAS via WoL. If it still fails (night, NAS gone):
# retry every 2 h, at most 6x a day; after that backup-check catches up.
StartLimitIntervalSec=1d
StartLimitBurst=6

[Service]
Type=oneshot
# No sleep in the middle of a run (hypridle checks for such inhibitors before suspending)
ExecStart=/usr/bin/systemd-inhibit --what=sleep --who=backup-nas --why="Backup storageD -> NAS running" %h/.local/bin/backup-documents nas
Restart=on-failure
RestartSec=2h
Nice=10
IOSchedulingClass=idle
