[Unit]
Description=Backup /mnt/storageD -> NAS
# Nur auf dem Desktop (GLaDOS). Auf dem Laptop sind die Timer ohnehin nicht aktiviert; das ist die Absicherung.
ConditionHost=GLaDOS
# NAS schläft -> alle 2 h neu versuchen, höchstens 6x am Tag
StartLimitIntervalSec=1d
StartLimitBurst=6

[Service]
Type=oneshot
ExecStart=%h/.local/bin/backup-documents nas
Restart=on-failure
RestartSec=2h
Nice=10
IOSchedulingClass=idle
