[Unit]
Description=Hyprland user session services
# The only place the services hang off (they have no [Install] themselves).
Wants=hypridle.service hyprpaper.service hyprsunset.service dunst.service waybar.service cliphist-text.service cliphist-image.service power-profile.service headset.service hyprpolkitagent.service theme-wallpaper.timer media-watch.service bt-idle-off.timer
# uwsm-app (binds, launcher, Waybar) starts programs through this daemon; started in advance
# there is no one-second wait on the first call after login.
Wants=wayland-wm-app-daemon.service
After=graphical-session-pre.target graphical-session.target
# Stop with the uwsm session, before Hyprland (wayland-wm@, Before=graphical-session.target)
# exits - otherwise waybar/hyprpaper/hyprsunset lose the display at logout and crash.
PartOf=graphical-session.target

[Install]
# Starts as soon as uwsm reports the session as ready (uwsm finalize in hyprland.lua).
# Once per machine: systemctl --user enable hypr-session.target
WantedBy=graphical-session.target
