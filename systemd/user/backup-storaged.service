[Unit]
Description=Backup ~/Documents -> /mnt/storageD
# Nur auf dem Desktop (GLaDOS). Auf dem Laptop sind die Timer ohnehin nicht aktiviert; das ist die Absicherung.
ConditionHost=GLaDOS
# Danach direkt storageD -> NAS (statt eigenem Timer, der nur per Uhrzeit hinterherlief).
OnSuccess=backup-nas.service

[Service]
Type=oneshot
# Kein Ruhezustand mitten im Lauf (hypridle prüft vor dem Suspend auf solche Sperren)
ExecStart=/usr/bin/systemd-inhibit --what=sleep --who=backup-storaged --why="Backup Dokumente -> storageD läuft" %h/.local/bin/backup-documents storaged
Nice=10
IOSchedulingClass=idle
