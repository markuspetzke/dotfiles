[Unit]
Description=Backup ~/Documents -> /mnt/storageD
# Desktop only (GLaDOS). The timers are not enabled on the laptop anyway; this is the safeguard.
ConditionHost=GLaDOS
# Then storageD -> NAS right away (instead of an own timer that only followed by clock time).
OnSuccess=backup-nas.service

[Service]
Type=oneshot
# No sleep in the middle of a run (hypridle checks for such inhibitors before suspending)
ExecStart=/usr/bin/systemd-inhibit --what=sleep --who=backup-storaged --why="Backup documents -> storageD running" %h/.local/bin/backup-documents storaged
Nice=10
IOSchedulingClass=idle
