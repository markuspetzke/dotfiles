// Fallback ohne -c: Desktop-Profil. Hyprland startet waybar mit config-<host>.jsonc.
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 1,
    "margin": 0,
    // Theme-Module zuerst: bei gleichen Schluesseln gewinnt die zuerst eingebundene Datei.
    "include": ["~/.config/theme-current/waybar-modules.jsonc", "~/.config/waybar/modules.jsonc"],

    "modules-left": ["hyprland/workspaces", "custom/playerctl"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["custom/power-profile", "idle_inhibitor", "pulseaudio", "network", "cpu", "memory", "temperature", "clock", "tray"],

    "temperature": {
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input"
    }
}
