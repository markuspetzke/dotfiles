// Gemeinsame Modul-Definitionen fuer Desktop und Laptop.
{
    "hyprland/window": {
        "separate-outputs": true,
        "max-length": 60
    },
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        // Nur Workspaces mit Fenstern (plus der aktive) -- keine persistenten Platzhalter.
        "show-special": false
    },


    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "uwsm-app -- pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%"
    },


    "network": {
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-linked": "{ifname}: verbunden, keine IP",
        "tooltip-format-disconnected": "Keine Verbindung",
        "on-click": "uwsm-app -- kitty -e nmtui"
    },

    "cpu": {
        "format": "󰘚 {usage}%",
        "interval": 2,
        "tooltip-format": "Last: {load}",
        "on-click": "uwsm-app -- kitty -e htop"
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 5,
        "tooltip-format": "RAM: {used:0.1f} / {total:0.1f} GiB\nSwap: {swapUsed:0.1f} / {swapTotal:0.1f} GiB",
        "on-click": "uwsm-app -- kitty -e htop"
    },

    "temperature": {
        "input-filename": "temp1_input",
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["󱃃", "󰔏", "󱃂"],
        "on-click": "uwsm-app -- kitty -e s-tui"
    },

    "custom/playerctl": {
        "format": "{icon} {text}",
        "format-icons": { "Playing": "󰐊", "Paused": "󰏤", "default": "󰐊" },
        "return-type": "json",
        "max-length": 40,
        "exec": "playerctl -a metadata --format '{\"text\": \"{{markup_escape(artist)}} - {{markup_escape(title)}}\", \"tooltip\": \"{{playerName}}: {{markup_escape(artist)}} - {{markup_escape(title)}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F",
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl next"
    },

    // Leistenposition und Modulabstand (Themes koennen sie ueberschreiben, z. B. winxp)
    "position": "top",
    "spacing": 1,

    // Startknopf-Bild: nur sichtbar, wenn das Theme private/start-icon.png hat (winxp)
    "image#start": {
        "exec": "f=\"$HOME/.config/theme-current/private/start-icon.png\"; [ -f \"$f\" ] && echo \"$f\"",
        "size": 20,
        "interval": 86400,
        "on-click": "~/.config/bin/menu",
        "tooltip": false
    },

    // Startknopf: nur sichtbar, wenn das Theme "exec" setzt (winxp).
    "custom/start": {
        "exec": "true",
        "interval": "once"
    },

    // Nur sichtbar, wenn das Theme "exec" setzt (z. B. wired: CONNECTED hh:mm).
    "custom/uptime": {
        "exec": "true",
        "interval": "once"
    },

    "clock": {
        "format": "󰥔 {:%H:%M}",
        "format-alt": "󰃮 {:%a, %d.%m.%Y}",
        "locale": "de_AT.UTF-8",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            // Standardfarben; die Themes ueberschreiben sie (themes/<name>/waybar-modules.jsonc)
            "format": {
                "months":   "<span color='#e6dcc3'><b>{}</b></span>",
                "days":     "<span color='#e6dcc3'>{}</span>",
                "weeks":    "<span color='#8a8370'><b>KW{}</b></span>",
                "weekdays": "<span color='#8f9a5b'><b>{}</b></span>",
                "today":    "<span color='#e8a33d'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "tray": {
        "icon-size": 18,
        "spacing": 5
    },

    "idle_inhibitor": {
        // Kein tooltip-format-*: crasht in waybar 0.15 beim Klick ("argument not found").
        "format": "{icon}",
        "format-icons": { "activated": "󰅶", "deactivated": "󰾪" }
    },

    // Eingebautes Modul (D-Bus, ohne Polling): zeigt Wechsel sofort, Klick naechstes Profil,
    // Rechtsklick vorheriges. Ohne power-profiles-daemon blendet es sich aus.
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power-Profil: {profile}\nKlick: wechseln",
        "format-icons": {
            "default": "󰾆",
            "performance": "󰓅",
            "balanced": "󰾅",
            "power-saver": "󰾆"
        }
    },

    "custom/headset": {
        "exec": "bash ~/.config/hypr/scripts/waybar-headset.sh",
        "return-type": "json",
        "interval": 60,
        "on-click": "uwsm-app -- pavucontrol"
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}\n{power}W"
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
        "on-scroll-down": "brightnessctl -e4 -n2 set 5%-"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-connected": "󰂱 {num_connections}",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "uwsm-app -- kitty -e bluetuith"
    },

    "network#wifi": {
        "interface": "wl*",
        "format-wifi": "{icon}",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Kein WLAN",
        "on-click": "uwsm-app -- kitty -e nmtui"
    }

}
