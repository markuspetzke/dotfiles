// Bar settings and module definitions shared by desktop and laptop; the profile configs
// (config-desktop.jsonc, config-laptop.jsonc) add the right-hand modules. Themes override
// single keys in themes/<name>/waybar-modules.jsonc (included first: the first file wins).
{
    // Bar (themes may override these, e.g. winxp: bottom, no spacing)
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin": 0,
    "spacing": 1,
    "modules-left": ["image#start", "custom/start", "hyprland/workspaces", "mpris"],
    "modules-center": ["hyprland/window"],

    "hyprland/window": {
        "separate-outputs": true,
        "max-length": 60
    },
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        // Only workspaces with windows (plus the active one) -- no persistent placeholders.
        "show-special": false
    },


    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "uwsm-app -- pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        // Built-in scrolling (no pactl call per step), capped at 100 % ("max-volume").
        "scroll-step": 2
    },


    "network": {
        "format-ethernet": "󰈀",
        "format-linked": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-linked": "{ifname}: connected, no IP",
        "tooltip-format-disconnected": "No connection",
        "on-click": "uwsm-app -- kitty -e nmtui"
    },

    "cpu": {
        "format": "󰘚 {usage}%",
        "interval": 2,
        "tooltip-format": "Load: {load}",
        "on-click": "uwsm-app -- kitty -e htop"
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 5,
        "tooltip-format": "RAM: {used:0.1f} / {total:0.1f} GiB\nSwap: {swapUsed:0.1f} / {swapTotal:0.1f} GiB",
        "on-click": "uwsm-app -- kitty -e htop"
    },

    "temperature": {
        "input-filename": "temp1_input",
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["󱃃", "󰔏", "󱃂"],
        "on-click": "uwsm-app -- kitty -e s-tui"
    },

    // Media player through MPRIS (built in, no script): follows the most recently active
    // player (playerctld). Click: play/pause, middle click: previous, right click: next track.
    "mpris": {
        "format": "{status_icon} {dynamic}",
        "format-stopped": "",
        "dynamic-order": ["artist", "title"],
        // Cuts the whole label; "dynamic-len" would drop a long title entirely.
        "max-length": 40,
        "status-icons": { "playing": "󰐊", "paused": "󰏤" },
        "tooltip-format": "{player}: {dynamic}"
    },

    // Start button image: only visible if the theme has private/start-icon.png (winxp)
    "image#start": {
        "exec": "f=\"$HOME/.config/theme-current/private/start-icon.png\"; [ -f \"$f\" ] && echo \"$f\"",
        "size": 20,
        "interval": 86400,
        "on-click": "~/.config/bin/menu",
        "tooltip": false
    },

    // Start button: only visible if the theme sets "exec" (winxp).
    "custom/start": {
        "exec": "true",
        "interval": "once"
    },

    // Only visible if the theme sets "exec" (e.g. wired: CONNECTED hh:mm).
    "custom/uptime": {
        "exec": "true",
        "interval": "once"
    },

    "clock": {
        "format": "󰥔 {:%H:%M}",
        "format-alt": "󰃮 {:%a, %d.%m.%Y}",
        "locale": "en_US.UTF-8",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            // iso8601: weeks start on Monday regardless of the locale
            "iso8601": true,
            // Default colors; the themes override them (themes/<name>/waybar-modules.jsonc)
            "format": {
                "months":   "<span color='#e6dcc3'><b>{}</b></span>",
                "days":     "<span color='#e6dcc3'>{}</span>",
                "weeks":    "<span color='#8a8370'><b>W{}</b></span>",
                "weekdays": "<span color='#8f9a5b'><b>{}</b></span>",
                "today":    "<span color='#e8a33d'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "tray": {
        "icon-size": 18,
        "spacing": 5
    },

    "idle_inhibitor": {
        // No tooltip-format-*: crashes in waybar 0.15 on click ("argument not found").
        "format": "{icon}",
        "format-icons": { "activated": "󰅶", "deactivated": "󰾪" }
    },

    // Built-in module (D-Bus, no polling): shows changes right away, click = next profile,
    // right click = previous one. Hides itself without power-profiles-daemon.
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip-format": "Power profile: {profile}\nClick: switch",
        "format-icons": {
            "default": "󰾆",
            "performance": "󰓅",
            "balanced": "󰾅",
            "power-saver": "󰾆"
        }
    },

    "custom/headset": {
        "exec": "bash ~/.config/hypr/scripts/waybar-headset.sh",
        "return-type": "json",
        "interval": 60,
        "on-click": "uwsm-app -- pavucontrol"
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}\n{power}W"
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
        "on-scroll-down": "brightnessctl -e4 -n2 set 5%-"
    },

    // Bluetooth starts powered off (laptop: AutoEnable=false) and goes off again after 10 min
    // without a device (bt-idle-off.timer). Click: on + bluetui, right click: on/off (bin/bt).
    "bluetooth": {
        "format": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-connected": "󰂱 {device_alias}",
        "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
        "max-length": 24,
        "tooltip-format": "{controller_alias}: on, nothing connected\nclick: devices · right click: off",
        "tooltip-format-off": "Bluetooth off\nclick: on + devices · right click: on",
        "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%",
        "on-click": "~/.config/bin/bt open",
        "on-click-right": "~/.config/bin/bt toggle"
    },

    "network#wifi": {
        "interface": "wl*",
        "format-wifi": "{icon}",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname}: {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "No Wi-Fi",
        "on-click": "uwsm-app -- kitty -e nmtui"
    }

}
