{
    "layer": "top",
    // "position" lives in modules.jsonc (default top), themes may override it
    "height": 30,
    // "spacing" lives in modules.jsonc (default 1), themes may override it
    "margin": 0,
    // Theme modules first: for identical keys the file included first wins.
    "include": ["~/.config/theme-current/waybar-modules.jsonc", "~/.config/waybar/modules.jsonc"],

    "modules-left": ["image#start", "custom/start", "hyprland/workspaces", "custom/playerctl"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["power-profiles-daemon", "idle_inhibitor", "custom/headset", "pulseaudio", "network", "cpu", "memory", "temperature", "custom/uptime", "clock", "tray"],

    "temperature": {
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input"
    }
}
