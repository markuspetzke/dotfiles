// Desktop bar. Shared bar settings and module definitions: modules.jsonc. Themes override
// single keys in themes/<name>/waybar-modules.jsonc (included first: the first file wins).
{
    "include": ["~/.config/theme-current/waybar-modules.jsonc", "~/.config/waybar/modules.jsonc"],
    "modules-right": ["power-profiles-daemon", "idle_inhibitor", "custom/headset", "pulseaudio", "network", "cpu", "memory", "temperature", "custom/uptime", "clock", "tray"],

    // CPU sensor (k10temp) by its PCI path: the hwmonN number can change between boots.
    "temperature": {
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input"
    }
}
