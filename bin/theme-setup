#!/usr/bin/env bash
# Setup on a new machine (e.g. laptop) after `git clone` or `git pull`:
#   ~/.config/bin/theme-setup [theme]   # default: keep the current theme, otherwise retro
#   ~/.config/bin/theme-setup --check   # check only (programs, system steps), change nothing
# Does: link scripts into ~/.local/bin, hook up the bash config and the commit check,
# install the pixel font (Departure Mono Nerd Font, OFL) if missing,
# enable the session services, tidy up the launcher, set the theme.
# At the end: missing programs and the one-time sudo steps (logind, greeter, ...).
set -euo pipefail
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
profile=$("$cfg/hypr/scripts/hypr-profile.sh")

# Programs called by configs and scripts: "command Arch-package"
check_programs() {
	local missing=() cmd pkg
	while read -r cmd pkg; do
		command -v "$cmd" >/dev/null || missing+=("$pkg")
	done <<-EOT
		hypridle hypridle
		hyprlock hyprlock
		hyprpaper hyprpaper
		hyprsunset hyprsunset
		hyprlauncher hyprlauncher
		waybar waybar
		dunst dunst
		kitty kitty
		thunar thunar
		playerctl playerctl
		wl-copy wl-clipboard
		cliphist cliphist
		grim grim
		slurp slurp
		notify-send libnotify
		wpctl wireplumber
		powerprofilesctl power-profiles-daemon
		uwsm-app uwsm
	EOT
	systemctl --user cat hyprpolkitagent.service >/dev/null 2>&1 || missing+=(hyprpolkitagent)
	python3 -c 'import PIL' 2>/dev/null || missing+=(python-pillow)
	# Theme start menus (themes/*/startmenu.py, e.g. winxp) are Python GTK 3 programs
	python3 -I -c 'import gi; gi.require_version("Gtk", "3.0")' 2>/dev/null || missing+=(python-gobject)
	if [[ $profile == laptop ]] && ! command -v brightnessctl >/dev/null; then
		missing+=(brightnessctl)
	fi
	# Bluetooth (Waybar module, bin/bt): only with an adapter
	if [[ -e /sys/class/bluetooth/hci0 ]] && ! command -v bluetui >/dev/null; then
		missing+=(bluetui)
	fi
	if ((${#missing[@]})); then
		echo "    MISSING: sudo pacman -S --needed ${missing[*]}"
	else
		echo "    all there"
	fi
}

# One-time steps with sudo that the script cannot do itself
check_system() {
	local todo=()
	if [[ $profile == laptop ]]; then
		local dst=/etc/systemd/logind.conf.d/90-hypr-laptop.conf
		cmp -s "$cfg/hypr/logind/laptop.conf" "$dst" ||
			todo+=("sudo install -Dm644 $cfg/hypr/logind/laptop.conf $dst   # lid; takes effect after a reboot")
		local can
		can=$(busctl call org.freedesktop.login1 /org/freedesktop/login1 \
			org.freedesktop.login1.Manager CanSuspendThenHibernate 2>/dev/null || true)
		[[ $can == 's "yes"' ]] ||
			echo "    Note: hibernation not set up, idle and lid use plain suspend"
	fi
	# power-profiles-daemon needs no enable: it starts on demand through D-Bus
	if [[ -f /etc/greetd/hyprland-greeter-config.lua && ! -O /var/lib/sysc-greet/themes ]]; then
		todo+=("sudo $cfg/bin/greeter-setup   # login screen follows the theme")
	fi
	if ((${#todo[@]})); then
		printf '    %s\n' "${todo[@]}"
	else
		echo "    nothing pending"
	fi
}

if [[ ${1:-} == --check ]]; then
	echo "Profile: $profile"
	echo "Programs"
	check_programs
	echo "System steps (sudo)"
	check_system
	exit 0
fi

echo "1/7 Scripts into ~/.local/bin"
mkdir -p "$HOME/.local/bin"
for f in "$cfg"/bin/*; do
	[[ -x $f && ! -d $f ]] || continue
	ln -sf "$f" "$HOME/.local/bin/$(basename "$f")"
done

echo "2/7 Bash and git"
# ~/.bashrc loads the bash config from the repo (bash/bashrc); existing lines stay
if ! grep -q 'config/bash/bashrc' "$HOME/.bashrc" 2>/dev/null; then
	printf '\n# Bash config from the dotfiles repo\n[[ -r ~/.config/bash/bashrc ]] && . ~/.config/bash/bashrc\n' >>"$HOME/.bashrc"
	echo "    ~/.bashrc now loads ~/.config/bash/bashrc"
fi
# Check before every commit (bin/dotfiles-check through .githooks/pre-commit)
git -C "$cfg" config core.hooksPath .githooks
git config --global user.name >/dev/null || echo "    Note: git name and mail missing (git config --global user.name/user.email)"

echo "3/7 Fonts"
if ! fc-list : family | grep -q "DepartureMono Nerd Font"; then
	tmp=$(mktemp -d)
	trap 'rm -rf "$tmp"' EXIT
	curl -sSfL -o "$tmp/dm.tar.xz" https://github.com/ryanoasis/nerd-fonts/releases/download/v3.4.0/DepartureMono.tar.xz
	mkdir -p "$HOME/.local/share/fonts/DepartureMono"
	tar -xJf "$tmp/dm.tar.xz" -C "$HOME/.local/share/fonts/DepartureMono" --wildcards '*.otf' 'LICENSE*' 2>/dev/null ||
		tar -xJf "$tmp/dm.tar.xz" -C "$HOME/.local/share/fonts/DepartureMono"
	fc-cache -f "$HOME/.local/share/fonts" >/dev/null
	echo "    Departure Mono Nerd Font installed"
else
	echo "    Departure Mono Nerd Font present"
fi
for fam in "FiraCode Nerd Font" "Noto Sans"; do
	fc-list : family | grep -q "$fam" || echo "    MISSING: $fam (install the package ttf-firacode-nerd or noto-fonts)"
done

echo "4/7 systemd"
systemctl --user daemon-reload
# Starts all session services with Hyprland (the link for it is not in git)
systemctl --user enable --quiet hypr-session.target
systemctl --user start theme-wallpaper.timer 2>/dev/null || true

# Spotify: link the Spicetify theme (color schemes in themes/spicetify/color.ini)
if command -v spicetify >/dev/null; then
	themes_dir=$(dirname "$(spicetify -c 2>/dev/null)")/Themes
	mkdir -p "$themes_dir" && ln -sfn "$cfg/themes/spicetify" "$themes_dir/DesktopTheme"
	echo "    Spicetify: DesktopTheme linked (needed once: spicetify backup apply)"
fi

echo "5/7 Tidy up the launcher"
"$cfg/bin/launcher-hide" >/dev/null || true

echo "6/7 Theme"
current=$(basename "$(readlink "$cfg/theme-current" 2>/dev/null || true)")
"$cfg/bin/theme" "${1:-${current:-retro}}"

echo "7/7 Checks ($profile)"
check_programs
check_system

cat <<EOT

Done. Optional:
    Helium: helium://extensions -> Load unpacked -> ~/.local/share/theme-browser
EOT
