#!/usr/bin/env python3
"""Hides the programs listed in hypr/launcher-hidden.txt from the launcher.

For that it puts a copy of the system entry with NoDisplay=true into ~/.local/share/applications
(the same desktop ID overrides the system entry). Programs stay installed, file
associations keep working. Own copies are marked: once a program is no longer in the
list, its copy is removed again. Every run regenerates the copies from the current
system entry (e.g. after package updates)."""
import glob
import os
import subprocess

cfg = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
local = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "applications")
MARK = "# Hidden by ~/.config/bin/launcher-hide (list: hypr/launcher-hidden.txt)\n"
# Marker of copies made before the English rename; still recognized as our own
MARKS = (MARK, "# Ausgeblendet von ~/.config/bin/launcher-hide (Liste: hypr/launcher-hidden.txt)\n")
SYSTEM = ["/usr/local/share/applications", "/usr/share/applications", "/var/lib/flatpak/exports/share/applications"]

wanted = []
for line in open(os.path.join(cfg, "hypr/launcher-hidden.txt")):
    line = line.strip()
    if line and not line.startswith("#"):
        wanted.append(line)

os.makedirs(local, exist_ok=True)

# Remove own copies that are no longer wanted
for f in glob.glob(os.path.join(local, "*.desktop")):
    with open(f, encoding="utf-8", errors="replace") as fh:
        if fh.readline() in MARKS and os.path.basename(f) not in wanted:
            os.remove(f)
            print("visible again:", os.path.basename(f))

for did in wanted:
    src = next((os.path.join(d, did) for d in SYSTEM if os.path.isfile(os.path.join(d, did))), None)
    dst = os.path.join(local, did)
    if src is None:
        print("not installed, skipped:", did)
        continue
    if os.path.exists(dst):
        with open(dst, encoding="utf-8", errors="replace") as fh:
            if fh.readline() not in MARKS:
                print("own entry present, left alone:", did)
                continue
    out, section = [MARK], None
    with open(src, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            s = line.strip()
            if s.startswith("[") and s.endswith("]"):
                section = s
                out.append(line)
                if s == "[Desktop Entry]":
                    out.append("NoDisplay=true\n")
                continue
            if section == "[Desktop Entry]" and s.split("=", 1)[0].strip() == "NoDisplay":
                continue  # replace the existing value
            out.append(line)
    with open(dst, "w", encoding="utf-8") as fh:
        fh.writelines(out)
    print("hidden:", did)

# Restart the launcher daemon so it rereads the list
if subprocess.run(["pkill", "-x", "hyprlauncher"]).returncode == 0:
    subprocess.run(["hyprctl", "dispatch", 'hl.dsp.exec_cmd("hyprlauncher -d")'], stdout=subprocess.DEVNULL)
