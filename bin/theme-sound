#!/bin/sh
# Plays a sound of the active theme, if there is one:
#   theme-sound [--wait] notify|critical|lock|unlock|startup|shutdown
# --wait: blocks until the sound has finished (e.g. before powering off).
# Search order: themes/<name>/private/sounds/<event>.{wav,ogg,flac,mp3} (own files,
# not in git), then themes/<name>/sounds/<event>.wav (generated sounds).
# Called by dunst as "script" (5 arguments: app, summary, body, icon, urgency):
# LOW -> silent, CRITICAL -> "critical" (if present, notify otherwise), otherwise "notify".
wait=""
[ "${1:-}" = "--wait" ] && { wait=1; shift; }
if [ $# -ge 5 ]; then
	case "$5" in
	LOW) exit 0 ;;
	CRITICAL) event=critical ;;
	*) event=notify ;;
	esac
else
	event=${1:-notify}
fi
theme="${XDG_CONFIG_HOME:-$HOME/.config}/theme-current"

find_sound() {
	for f in "$theme/private/sounds/$1".wav "$theme/private/sounds/$1".ogg "$theme/private/sounds/$1".flac \
		"$theme/private/sounds/$1".mp3 "$theme/sounds/$1.wav"; do
		[ -f "$f" ] && { echo "$f"; return 0; }
	done
	return 1
}

file=$(find_sound "$event") || { [ "$event" = critical ] && file=$(find_sound notify); } || exit 0
[ -n "$file" ] || exit 0
command -v pw-play >/dev/null || exit 0
if [ -n "$wait" ]; then
	pw-play --volume 0.6 "$file" >/dev/null 2>&1
else
	pw-play --volume 0.6 "$file" >/dev/null 2>&1 &
fi
