#!/usr/bin/env bash
# Tests the idle chain with short timeouts, without waiting 10 minutes:
#   (laptop: 5 s dim ->) 10 s screensaver -> 20 s lock -> 30 s monitors off.
#   No suspend. Uses the profile's config (hypridle.conf or hypridle-laptop.conf).
#   idle-test [seconds]   # test duration, default 60; Ctrl+C aborts
# Stops hypridle.service for this and always starts it again afterwards.
set -uo pipefail
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
dur=${1:-60}
conf="$cfg/hypr/hypridle.conf"
[[ $("$cfg/hypr/scripts/hypr-profile.sh") == laptop ]] && conf="$cfg/hypr/hypridle-laptop.conf"
tmp=$(mktemp --suffix=.conf)
pid=""

restore() {
	trap - EXIT INT TERM HUP
	[[ -n $pid ]] && kill "$pid" 2>/dev/null
	rm -f "$tmp"
	systemctl --user start hypridle.service
	echo
	echo "Test finished, hypridle runs with the normal timeouts again."
}
trap restore EXIT INT TERM HUP

if playerctl -a status 2>/dev/null | grep -q Playing; then
	echo "Note: music/video is playing -> media-watch.service holds an idle inhibitor,"
	echo "so the chain deliberately does nothing. Please pause and start again (or Ctrl+C)."
	exit 1
fi

sed -e 's/timeout = 300$/timeout = 5/' \
	-e 's/timeout = 540$/timeout = 10/' \
	-e 's/screensaver start 60 90$/screensaver start 10 20/' \
	-e 's/timeout = 600$/timeout = 20/' \
	-e 's/timeout = 630$/timeout = 30/' \
	-e '/timeout = \(900\|3600\)$/,/}/ s/on-timeout = .*/on-timeout = true  # no suspend in the test/' \
	"$conf" >"$tmp"

systemctl --user stop hypridle.service
hypridle -c "$tmp" >/dev/null 2>&1 &
pid=$!

echo "Idle test (${dur}s, $(basename "$conf")): let go of mouse and keyboard now."
grep -q 'timeout = 5$' "$tmp" && echo "  5 s dim"
echo "  10 s screensaver, 20 s lock, 30 s monitors off  (Ctrl+C aborts)"
for ((i = dur; i > 0; i--)); do
	kill -0 "$pid" 2>/dev/null || { echo "hypridle exited."; exit 1; }
	printf '\r  %3ds left ' "$i"
	sleep 1
done
