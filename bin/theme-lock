#!/bin/sh
# Lock: pause media, theme sound when locking, hyprlock, sound after unlocking.
# hypridle calls this as lock_cmd (hypr/hypridle.conf).
d="${XDG_CONFIG_HOME:-$HOME/.config}/bin"
# Pause all media (YouTube in the browser, Spotify, ...) before locking
command -v playerctl >/dev/null && playerctl -a pause 2>/dev/null
"$d/theme-sound" lock
hyprlock
"$d/screensaver" stop --force  # close the screensaver behind the lock
"$d/theme-sound" unlock
