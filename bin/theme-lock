#!/bin/sh
# Sperren: Medien pausieren, Theme-Sound beim Sperren, hyprlock, Sound nach dem Entsperren.
# hypridle ruft das als lock_cmd auf (hypr/hypridle.conf).
d="${XDG_CONFIG_HOME:-$HOME/.config}/bin"
# Alle Medien anhalten (YouTube im Browser, Spotify, ...), bevor gesperrt wird
command -v playerctl >/dev/null && playerctl -a pause 2>/dev/null
"$d/theme-sound" lock
hyprlock
"$d/screensaver" stop --force  # Schoner hinter der Sperre schliessen
"$d/theme-sound" unlock
