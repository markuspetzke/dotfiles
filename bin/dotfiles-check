#!/usr/bin/env bash
# Checks the dotfiles so no broken config reaches GitHub (and from there the laptop).
#   dotfiles-check            # all files in the repo
#   dotfiles-check --staged   # only the files staged for the commit (git hook .githooks/pre-commit)
# Checks: Lua (luacheck, otherwise luac -p), shell (bash -n/sh -n, plus shellcheck if installed),
# Python (syntax), JSON and Waybar JSONC, systemd user units (systemd-analyze verify) and the
# running Hyprland config (hyprctl configerrors; Hyprland reloads changed files right away).
# Exit 1 on errors, which aborts the commit. In an emergency: git commit --no-verify
set -uo pipefail
cd "$(git -C "${XDG_CONFIG_HOME:-$HOME/.config}" rev-parse --show-toplevel)" || exit 2

if [[ ${1:-} == --staged ]]; then
	mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMR)
else
	mapfile -t files < <(git ls-files; git ls-files --others --exclude-standard)
fi

errors=0
fail() { # fail <file> <message...>
	printf 'ERROR %s\n%s\n' "$1" "$(printf '%s\n' "${@:2}" | sed 's/^/    /')"
	errors=$((errors + 1))
}

lua=() shells=() pys=() jsons=() units=()
for f in "${files[@]}"; do
	[[ -f $f && ! -L $f ]] || continue
	case $f in
	*.lua) lua+=("$f") ;;
	*.py) pys+=("$f") ;;
	*.json | *.jsonc) jsons+=("$f") ;;
	systemd/user/*.service | systemd/user/*.timer | systemd/user/*.target | systemd/user/*.socket) units+=("$f") ;;
	bash/*) shells+=("$f") ;; # bash config without a shebang
	*)
		first=$(head -n1 "$f" 2>/dev/null | tr -d '\0')
		case $first in
		'#!'*python*) pys+=("$f") ;;
		'#!'*bash* | '#!'*/sh | '#!'*'env sh') shells+=("$f") ;;
		esac
		;;
	esac
done

# Lua: Hyprland (hl), Neovim (vim, Snacks)
if ((${#lua[@]})); then
	if command -v luacheck >/dev/null; then
		out=$(luacheck "${lua[@]}" --globals hl vim Snacks --no-max-line-length --codes -q --no-color 2>&1) ||
			fail "Lua" "$(grep -v -E '^Total:' <<<"$out")"
	else
		for f in "${lua[@]}"; do out=$(luac -p "$f" 2>&1) || fail "$f" "$out"; done
	fi
fi

# Shell: syntax, plus common mistakes (warning and up) if shellcheck is installed
for f in "${shells[@]}"; do
	sh=bash
	head -n1 "$f" | grep -q -E '/sh$|env sh' && sh=sh
	out=$($sh -n "$f" 2>&1) || { fail "$f" "$out"; continue; }
	if command -v shellcheck >/dev/null; then
		out=$(shellcheck -S warning -x "$f" 2>&1) || fail "$f" "$out"
	fi
done

# Python: syntax only, without creating __pycache__
for f in "${pys[@]}"; do
	out=$(python3 -I -c 'import ast, sys; ast.parse(open(sys.argv[1], "rb").read(), sys.argv[1])' "$f" 2>&1) ||
		fail "$f" "$(tail -n 3 <<<"$out")"
done

# JSON/JSONC: strip comments (// and /* */ outside of strings), then parse
for f in "${jsons[@]}"; do
	out=$(python3 -I - "$f" 2>&1 <<-'EOF'
		import json, sys
		s = open(sys.argv[1], encoding="utf-8").read()
		o, i, n, q = [], 0, len(s), False
		while i < n:
		    c = s[i]
		    if q:
		        o.append(c)
		        if c == "\\": o.append(s[i + 1]); i += 1
		        elif c == '"': q = False
		    elif c == '"': q = True; o.append(c)
		    elif s.startswith("//", i): i = s.find("\n", i); i = n if i < 0 else i; continue
		    elif s.startswith("/*", i): j = s.find("*/", i + 2); i = n if j < 0 else j + 2; continue
		    else: o.append(c)
		    i += 1
		json.loads("".join(o))
	EOF
	) || fail "$f" "$(tail -n 1 <<<"$out")"
done

# systemd user units. Missing programs outside the repo (e.g. backup scripts in
# ~/.local/bin that only exist on the desktop) are not an error.
if ((${#units[@]})); then
	out=$(systemd-analyze --user verify "${units[@]}" 2>&1 | grep -v -E 'is not executable: No such file or directory|^$')
	[[ -z $out ]] || fail "systemd-Units" "$out"
fi

# Running Hyprland config (only when Lua files are involved and Hyprland runs)
if ((${#lua[@]})) && [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
	out=$(hyprctl configerrors 2>/dev/null | grep -v -E '^\s*$')
	[[ -z $out ]] || fail "Hyprland (hyprctl configerrors)" "$out"
fi

total=$((${#lua[@]} + ${#shells[@]} + ${#pys[@]} + ${#jsons[@]} + ${#units[@]}))
if ((errors)); then
	echo "dotfiles-check: $errors problem(s) in $total checked file(s)."
	exit 1
fi
echo "dotfiles-check: $total file(s) ok (Lua ${#lua[@]}, shell ${#shells[@]}, Python ${#pys[@]}, JSON ${#jsons[@]}, units ${#units[@]})."
