#!/usr/bin/env python3
"""Tags windows with playing video (Hyprland tag "video") so themes with dim_inactive
do not dim them (rule "no-dim-video" in hypr/theme.lua). Runs in the background (does not
block the compositor) and only on events: Hyprland starts it on window changes
(hypr/theme.lua), media-watch.service on play/pause/title changes of a player.
Video = a medium is playing (playerctl "Playing") and its title is in the window title (e.g. YouTube),
or the window inhibits the screen lock, reports content type "video" or is a player."""
import json
import subprocess

PLAYERS = {"mpv", "vlc", "org.videolan.VLC", "celluloid", "io.github.celluloid_player.Celluloid", "org.gnome.Totem"}


def run(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


playing = []
for line in run("playerctl", "-a", "metadata", "--format", "{{status}}\t{{title}}").splitlines():
    status, _, title = line.partition("\t")
    if status == "Playing" and len(title.strip()) >= 3:
        playing.append(title.strip().lower())

try:
    clients = json.loads(run("hyprctl", "clients", "-j") or "[]")
except json.JSONDecodeError:
    clients = []

for c in clients:
    wtitle = (c.get("title") or "").lower()
    video = bool(
        c.get("inhibitingIdle")
        or c.get("contentType") == "video"
        or c.get("class") in PLAYERS
        or any(t in wtitle for t in playing)
    )
    tags = c.get("tags") or []
    tagged = "video" in tags if isinstance(tags, list) else "video" in str(tags)
    if video != tagged:
        sign = "+" if video else "-"
        run("hyprctl", "dispatch", f'hl.dsp.window.tag({{ tag = "{sign}video", window = "address:{c["address"]}" }})')
