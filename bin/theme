#!/usr/bin/env bash
# Switch the desktop theme (Hyprland, Waybar, Dunst, Hyprlock, launcher, Kitty, Neovim, fastfetch).
#
#   theme            # available themes, active one marked
#   theme <name>     # activate and reload everything
#   theme --session  # only set the active theme's cursor (Hyprland start, hypr/theme.lua)
#
# Themes live in ~/.config/themes/<name>/. The active one is where the symlink
# ~/.config/theme-current points (not in git, so per machine).
set -euo pipefail

cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
themes="$cfg/themes"
link="$cfg/theme-current"
current=$(basename "$(readlink "$link" 2>/dev/null || true)")

list() {
	for d in "$themes"/*/; do
		[[ -f $d/palette.lua ]] || continue
		n=$(basename "$d")
		[[ $n == "$current" ]] && echo "* $n" || echo "  $n"
	done
}

# Cursor: link themes/<name>/cursor/<Name>/ into ~/.local/share/icons and set it,
# otherwise the default from uwsm/env (XCURSOR_THEME).
apply_cursor() {
	local dir name size=${XCURSOR_SIZE:-24}
	# "|| true": themes without cursor/ must not abort the script (set -e)
	dir=$(find -L "$link/cursor" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | head -1 || true)
	if [[ -n $dir ]]; then
		name=$(basename "$dir")
		mkdir -p "$HOME/.local/share/icons"
		ln -sfn "$(readlink -f "$dir")" "$HOME/.local/share/icons/$name"
	else
		name=${XCURSOR_THEME:-Wii-Pointer-P1}
	fi
	hyprctl setcursor "$name" "$size" >/dev/null 2>&1 || true
	gsettings set org.gnome.desktop.interface cursor-theme "$name" 2>/dev/null || true
}

# Extra for hyprlock: logo from themes/<name>/private/logo.png, empty otherwise. The file always
# exists so "source" in the hyprlock themes never points to nothing.
write_lock_extra() {
	local state="${XDG_STATE_HOME:-$HOME/.local/state}/theme" logo="$link/private/logo.png"
	# Position/size per theme (themes/<name>/logo.conf: "position = x, y" / "size = n")
	local pos="0, 300" size=260
	if [[ -f $link/logo.conf ]]; then
		pos=$(sed -n 's/^position *= *//p' "$link/logo.conf" | head -1)
		size=$(sed -n 's/^size *= *//p' "$link/logo.conf" | head -1)
		pos=${pos:-0, 300}
		size=${size:-260}
	fi
	mkdir -p "$state"
	if [[ -f $logo ]]; then
		cat >"$state/hyprlock-extra.conf" <<-EOT
			# Generated by bin/theme: the theme's own logo (private/logo.png)
			image {
			    monitor =
			    path = $(readlink -f "$logo")
			    size = $size
			    rounding = 0
			    border_size = 0
			    position = $pos
			    halign = center
			    valign = center
			}
		EOT
	else
		echo "# Generated by bin/theme: no own logo (themes/<name>/private/logo.png missing)" >"$state/hyprlock-extra.conf"
	fi
}

# Icon theme: link themes/<name>/(private/)icon-theme/<Name>/ and set it, Adwaita otherwise
apply_icons() {
	local dir name
	dir=$(find -L "$link/private/icon-theme" "$link/icon-theme" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | head -1 || true)
	if [[ -n $dir ]]; then
		name=$(basename "$dir")
		mkdir -p "$HOME/.local/share/icons"
		ln -sfn "$(readlink -f "$dir")" "$HOME/.local/share/icons/$name"
	else
		name=Adwaita
	fi
	gsettings set org.gnome.desktop.interface icon-theme "$name" 2>/dev/null || true
	# Thunar: with an own icon theme colored icons in the sidebar, symbolic ones otherwise
	if command -v xfconf-query >/dev/null; then
		local sym=true
		[[ -n $dir ]] && sym=false
		xfconf-query -c thunar -p /misc-symbolic-icons-in-sidepane -n -t bool -s "$sym" 2>/dev/null || true
		xfconf-query -c thunar -p /misc-symbolic-icons-in-toolbar -n -t bool -s "$sym" 2>/dev/null || true
	fi
}

# Running GTK programs (Thunar) only reload gtk.css on a theme change:
# switch the GTK theme briefly and back
reload_gtk() {
	local cur
	cur=$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | tr -d "'")
	[[ -n $cur ]] || return 0
	gsettings set org.gnome.desktop.interface gtk-theme Adwaita
	sleep 0.3
	gsettings set org.gnome.desktop.interface gtk-theme "$cur"
}

if (($# == 0)); then
	list
	exit 0
fi

if [[ $1 == --session ]]; then
	write_lock_extra
	apply_cursor
	"$cfg/bin/theme-sound" startup
	"$cfg/bin/menu" --preload
	exit 0
fi

name=$1
if [[ ! -f $themes/$name/palette.lua ]]; then
	echo "Unknown theme: $name" >&2
	list >&2
	exit 1
fi

"$cfg/bin/menu" --stop  # stop the old theme's start menu

# Relative symlink: works regardless of the home path
ln -sfn "themes/$name" "$link"

# Neovim: remember the colorscheme for new instances ...
cs=$(sed -n 's/^ *colorscheme = "\(.*\)",$/\1/p' "$themes/$name/nvim.lua" | head -1)
if [[ -n $cs ]]; then
	state="${XDG_STATE_HOME:-$HOME/.local/state}/nvim"
	mkdir -p "$state" && printf '%s' "$cs" >"$state/colorscheme"
fi
# ... and switch running instances through their socket (no key presses)
for sock in "${XDG_RUNTIME_DIR:-/run/user/$UID}"/nvim.*.0; do
	[[ -S $sock ]] || continue
	timeout 2 nvim --server "$sock" --remote-expr 'luaeval("require(\"config.theme\").reload()")' >/dev/null 2>&1 || true
done

# Reload only inside a running Hyprland session
if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
	hyprctl reload >/dev/null
	apply_cursor
	"$cfg/bin/theme-wallpaper" --no-reload
	write_lock_extra
	"$cfg/bin/theme-browser" >/dev/null || true
	"$cfg/bin/theme-fastfetch-logo" || true
	"$cfg/bin/menu" --preload
	apply_icons
	reload_gtk
	# Spotify (Spicetify): color scheme = theme name (themes/spicetify/color.ini), no restart
	spotify_note=""
	if command -v spicetify >/dev/null && grep -q "^\[$name\]" "$themes/spicetify/color.ini" 2>/dev/null; then
		spicetify config current_theme DesktopTheme color_scheme "$name" >/dev/null 2>&1 &&
			spicetify refresh -n >/dev/null 2>&1 || true
		pgrep -x spotify >/dev/null && spotify_note=", Spotify: after restart"
	fi
	thunar_note=""
	if pgrep -x thunar >/dev/null; then
		if hyprctl clients -j | grep -qi '"class": "thunar"'; then
			thunar_note=", Thunar: after restart"
		else
			thunar -q 2>/dev/null || true
		fi
	fi
	"$cfg/bin/theme-greeter" || true
	systemctl --user restart hyprpaper.service waybar.service dunst.service
	# hyprlauncher reads its theme (hypr/hyprtoolkit.conf) only at startup: restart the daemon
	if pkill -x hyprlauncher; then
		sleep 0.3
		hyprctl dispatch 'hl.dsp.exec_cmd("hyprlauncher -d")' >/dev/null
	fi
	pkill -USR1 -x kitty || true
	msg="$name is active"
	pgrep -x helium >/dev/null && msg="$msg (Helium: after restart)"
	msg="$msg$thunar_note$spotify_note"
	notify-send -t 3000 "Theme" "$msg"
fi
echo "Theme: $name"
