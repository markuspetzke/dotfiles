#!/bin/sh
# Todeszaehler fuer den Stream: stream-tode + | - | 0
# OBS-Textquelle "Todeszähler" liest ~/.local/share/stream/tode.txt (aktualisiert sich ~1x pro Sekunde).
# Hyprland: SUPER+X (+1), SUPER+SHIFT+X (-1), SUPER+CTRL+X (0)
dir="$HOME/.local/share/stream"
mkdir -p "$dir"
n=$(cat "$dir/tode.count" 2>/dev/null)
case "$n" in '' | *[!0-9]*) n=0 ;; esac
case "${1:-+}" in
    +) n=$((n + 1)) ;;
    -) [ "$n" -gt 0 ] && n=$((n - 1)) ;;
    0) n=0; notify-send -t 2000 "Todeszähler" "Auf 0 gesetzt" ;;
    *) echo "Benutzung: stream-tode + | - | 0" >&2; exit 1 ;;
esac
echo "$n" > "$dir/tode.count"
# Erst temporaer schreiben, dann umbenennen: OBS liest nie eine halbe Datei
printf 'Tode: %s' "$n" > "$dir/tode.txt.tmp" && mv "$dir/tode.txt.tmp" "$dir/tode.txt"
