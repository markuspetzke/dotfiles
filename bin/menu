#!/bin/sh
# Start menu: the active theme can bring its own (themes/<name>/startmenu.py,
# e.g. winxp), hyprlauncher otherwise. The start menu runs as a background process (fast);
# every call shows or hides it. Called by: Super key, start button in the bar.
#   menu            # show/hide
#   menu --preload  # only start in the background (at login, theme --session)
#   menu --stop     # stop the background process (on a theme switch)
menu="${XDG_CONFIG_HOME:-$HOME/.config}/theme-current/startmenu.py"
pidfile="${XDG_RUNTIME_DIR:-/tmp}/theme-startmenu.pid"

running() { [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; }

case "${1:-}" in
--stop)
	running && kill "$(cat "$pidfile")"
	rm -f "$pidfile"
	exit 0
	;;
--preload)
	[ -f "$menu" ] || exit 0
	running && exit 0
	setsid python3 -I "$menu" --daemon >/dev/null 2>&1 &  # writes its own PID
	exit 0
	;;
esac

if [ -f "$menu" ]; then
	if running; then
		kill -USR1 "$(cat "$pidfile")"
	else
		setsid python3 -I "$menu" --daemon --show >/dev/null 2>&1 &  # writes its own PID
	fi
	exit 0
fi
exec hyprlauncher -t
