#!/bin/sh
# Startmenue: das aktive Theme kann ein eigenes mitbringen (themes/<name>/startmenu.py,
# z. B. winxp), sonst hyprlauncher. Das Startmenue laeuft als Hintergrundprozess (schnell);
# jeder Aufruf blendet es ein bzw. aus. Aufruf: Super-Taste, Startknopf der Leiste.
#   menu            # ein-/ausblenden
#   menu --preload  # nur im Hintergrund starten (beim Login, theme --session)
#   menu --stop     # Hintergrundprozess beenden (bei Theme-Wechsel)
menu="${XDG_CONFIG_HOME:-$HOME/.config}/theme-current/startmenu.py"
pidfile="${XDG_RUNTIME_DIR:-/tmp}/theme-startmenu.pid"

running() { [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; }

case "${1:-}" in
--stop)
	running && kill "$(cat "$pidfile")"
	rm -f "$pidfile"
	exit 0
	;;
--preload)
	[ -f "$menu" ] || exit 0
	running && exit 0
	setsid python3 -I "$menu" --daemon >/dev/null 2>&1 &  # schreibt seine PID selbst
	exit 0
	;;
esac

if [ -f "$menu" ]; then
	if running; then
		kill -USR1 "$(cat "$pidfile")"
	else
		setsid python3 -I "$menu" --daemon --show >/dev/null 2>&1 &  # schreibt seine PID selbst
	fi
	exit 0
fi
exec hyprlauncher -t
