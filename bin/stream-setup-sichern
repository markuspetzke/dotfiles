#!/bin/sh
# Kopiert die Stream-Einrichtung nach ~/Documents/Twitch/setup/, damit sie mit dem
# normalen Monats-Backup (backup-storaged, ~/Documents) mitgesichert wird.
# Laeuft als ExecStartPre von backup-storaged.service, kann aber auch jederzeit von Hand laufen.
# Bewusst NICHT gesichert: Stream-Key (service.json) und Websocket-Passwort, da das Backup bis Hetzner geht.
set -eu
DST="$HOME/Documents/Twitch/setup"
mkdir -p "$DST/bin" "$DST/etc"

# OBS: Profile, Szenen, Skripte, Plugin-Einstellungen (ohne Logs, Browser-Cache, Geheimnisse, .bak)
rsync -a --delete \
	--exclude=logs/ --exclude=profiler_data/ --exclude=crashes/ \
	--exclude=plugin_config/obs-browser/ --exclude=plugin_config/obs-websocket/ \
	--exclude='basic/profiles/*/service.json' --exclude='*.bak*' \
	"$HOME/.config/obs-studio/" "$DST/obs-studio/"

# Eigene Skripte (sonycam, obs-spiel, Clip, Todeszaehler, Websocket-Client, dieses Skript)
for f in sonycam obs-spiel obs-spiel-audio obs-ws stream-tode stream-clip stream-setup-sichern; do
	[ -f "$HOME/.local/bin/$f" ] && cp -p "$HOME/.local/bin/$f" "$DST/bin/"
done

# Audio: virtuelle Ausgaenge Desktop/Spiel/Spotify, Spotify-Regeln, Headset-Mikro aus
rsync -a --delete "$HOME/.config/pipewire/" "$DST/pipewire/"
[ -d "$HOME/.config/wireplumber" ] && rsync -a --delete "$HOME/.config/wireplumber/" "$DST/wireplumber/"

# Kamera: v4l2loopback (/dev/video10 "SonyCam")
cp -p /etc/modprobe.d/*v4l2* /etc/modules-load.d/*v4l2* "$DST/etc/" 2>/dev/null || true

# Todeszaehler-Stand
cp -p "$HOME/.local/share/stream/tode.count" "$DST/" 2>/dev/null || true

cat > "$DST/WIEDERHERSTELLEN.txt" <<'EOF'
Stream-Einrichtung wiederherstellen (GLaDOS, Arch + Hyprland)

1. Pakete: obs-studio-browser (AUR, bringt ffmpeg-obs), obs-vkcapture + lib32-obs-vkcapture,
   v4l2loopback-dkms, gphoto2, python-pillow
2. obs-studio/  -> ~/.config/obs-studio/
   Danach in OBS den Stream-Key neu eintragen (Einstellungen -> Stream), er ist absichtlich nicht gesichert.
   Websocket in OBS einschalten (Werkzeuge -> WebSocket-Server), Passwort ist egal (obs-ws liest es aus der Config).
3. bin/*        -> ~/.local/bin/ (ausfuehrbar lassen)
4. pipewire/    -> ~/.config/pipewire/      wireplumber/ -> ~/.config/wireplumber/
   dann: systemctl --user restart pipewire pipewire-pulse wireplumber
         wpctl set-default <ID von obs_desktop>
5. etc/*v4l2*   -> /etc/modprobe.d/ bzw. /etc/modules-load.d/ (sudo), neu starten
6. tode.count   -> ~/.local/share/stream/
Hyprland-Tasten (SUPER+X/C, SUPER+W-Sperre) und TF2-Fensterregel liegen im Git-Repo ~/.config (hypr/).
EOF
echo "Stream-Einrichtung gesichert nach $DST"
