#!/bin/sh
# Screensaver of the active theme (themes/<name>/screensaver.py) on all monitors.
#   screensaver start [lock_after] [off_after]   # hypridle; default 60 / 90 s after the start
#   screensaver stop                              # hypridle on-resume (activity)
#   screensaver stop --force                      # after unlocking (bin/theme-lock)
# Hyprland counts opening/closing a window as activity: that resets hypridle's timers and
# fires on-resume right away. So "stop" ignores the first 3 s, and the screensaver locks
# and turns the monitors off by itself (the chain no longer depends on hypridle).
# Themes without screensaver.py: nothing happens, hypridle locks as usual.
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
prog="$cfg/theme-current/screensaver.py"
run="${XDG_RUNTIME_DIR:-/tmp}"
# Only the Python process of the animation (not kitty or the shell that starts it)
anim="^python3 -I $prog\$"

running() { pgrep -f "kitty --class screensaver" >/dev/null; }

case "${1:-start}" in
start)
	[ -f "$prog" ] || exit 0
	running && exit 0
	date +%s >"$run/screensaver.start"
	for mon in $(hyprctl monitors -j | python3 -c 'import json,sys; print(" ".join(m["name"] for m in json.load(sys.stdin)))'); do
		hyprctl dispatch "hl.dsp.exec_cmd(\"kitty --class screensaver -o window_padding_width=0 -o confirm_os_window_close=0 sh -c 'python3 -I $prog; $cfg/bin/screensaver stop --force'\", { monitor = \"$mon\", fullscreen = true })" >/dev/null
	done
	lock_after=${2:-60}
	dpms_after=${3:-90}
	(
		sleep "$lock_after"
		running || exit 0
		loginctl lock-session
		sleep $((dpms_after - lock_after))
		running && pidof hyprlock >/dev/null || exit 0
		hyprctl dispatch 'hl.dsp.dpms({action = "off"})' >/dev/null
		# Monitors off: pause the animation, otherwise it keeps running unseen until someone
		# comes back. Quitting would not work: closing counts as activity and turns the
		# monitors back on. "stop" resumes it and quits it.
		pkill -STOP -f "$anim"
	) >/dev/null 2>&1 &
	echo $! >"$run/screensaver.timer"
	;;
stop)
	if [ "${2:-}" != "--force" ] && [ -f "$run/screensaver.start" ]; then
		# Ignore activity caused by opening the screensaver itself
		[ $(($(date +%s) - $(cat "$run/screensaver.start"))) -lt 3 ] && exit 0
	fi
	[ -f "$run/screensaver.timer" ] && kill "$(cat "$run/screensaver.timer")" 2>/dev/null
	rm -f "$run/screensaver.timer" "$run/screensaver.start"
	pkill -CONT -f "$anim" # resume a paused animation (monitors off) so it ends cleanly
	pkill -f "kitty --class screensaver" || true
	;;
esac
