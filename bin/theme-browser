#!/usr/bin/env python3
"""Builds a Chromium theme extension for Helium from themes/<active>/browser.json:
~/.local/share/theme-browser/ (manifest.json + wallpaper as the new tab page background).

Once in Helium: helium://extensions -> developer mode on -> "Load unpacked"
-> pick ~/.local/share/theme-browser. Helium then rereads the folder at every start,
so a theme switch (`theme <name>`) applies after restarting Helium."""
import json
import os
import shutil
import sys

cfg = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
theme = os.path.join(cfg, "theme-current")
out = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "theme-browser")
src = os.path.join(theme, "browser.json")
if not os.path.isfile(src):
    sys.exit(0)

name = os.path.basename(os.path.realpath(theme))
spec = {k: v for k, v in json.load(open(src)).items() if not k.startswith("_")}
rgb = lambda h: [int(h[i:i + 2], 16) for i in (1, 3, 5)]

os.makedirs(os.path.join(out, "images"), exist_ok=True)
wall = os.path.join(theme, "wallpaper.png")
# Own image (private/, not in git) takes precedence: day variant or a single wallpaper
for cand in ("private/wallpapers/day.png", "private/wallpaper.png", "private/wallpaper.jpg", "private/wallpaper.webp"):
    if os.path.isfile(os.path.join(theme, cand)):
        wall = os.path.join(theme, cand)
        break
images = {}
if wall and os.path.isfile(wall):
    if wall.endswith(".png"):
        shutil.copyfile(wall, os.path.join(out, "images", "ntp.png"))
    else:  # jpg/webp -> png (Pillow), no image otherwise
        try:
            from PIL import Image
            Image.open(wall).convert("RGB").save(os.path.join(out, "images", "ntp.png"))
        except Exception:
            wall = ""
    images["theme_ntp_background"] = "images/ntp.png"

manifest = {
    "manifest_version": 3,
    "name": f"Desktop-Theme: {name}",
    "description": "Generated by ~/.config/bin/theme-browser from themes/" + name + "/browser.json",
    "version": "1.0",
    "theme": {
        "images": images,
        "colors": {k: rgb(v) for k, v in spec.items()},
        "properties": {"ntp_background_alignment": "center", "ntp_background_repeat": "no-repeat"},
    },
}
with open(os.path.join(out, "manifest.json"), "w") as f:
    json.dump(manifest, f, indent=2)
# Chromium caches the packed theme in the extension folder -> drop it, otherwise the old one stays
try:
    os.remove(os.path.join(out, "Cached Theme.pak"))
except FileNotFoundError:
    pass
print("Browser theme:", name)
