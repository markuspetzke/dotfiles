#!/bin/sh
# Picks the active theme's wallpaper by time of day and links it to
# ~/.local/state/theme/wallpaper.png (hyprpaper.conf and the hyprlock themes point there).
#   theme-wallpaper            # set it; restart hyprpaper only if something changes
#   theme-wallpaper --no-reload
#   THEME_TIME=0700 theme-wallpaper   # force a time (to test the phases)
# themes/<name>/wallpaper-phases: lines "HH:MM phase" -> wallpapers/<phase>.png.
# themes/<name>/wallpaper-rotate: interval in seconds -> wallpapers/*.png in turn.
# Otherwise themes/<name>/wallpaper.png applies. Own images: private/wallpapers/<phase>.png
# (per time of day) or private/wallpaper.* (always) take precedence. Runs every 10 min via theme-wallpaper.timer.
cfg="${XDG_CONFIG_HOME:-$HOME/.config}"
theme="$cfg/theme-current"
state="${XDG_STATE_HOME:-$HOME/.local/state}/theme"
mkdir -p "$state"

target="$theme/wallpaper.png"
if [ -f "$theme/wallpaper-phases" ]; then
	now=${THEME_TIME:-$(date +%H%M)}
	# last phase whose start time <= now; before the first line the last one applies (night)
	phase=$(grep -v '^#' "$theme/wallpaper-phases" | awk -v now="$now" '
		NF == 2 { t = $1; gsub(":", "", t); last = $2; if (t + 0 <= now + 0) cur = $2 }
		END { print (cur != "" ? cur : last) }')
	[ -f "$theme/wallpapers/$phase.png" ] && target="$theme/wallpapers/$phase.png"
	# own variant per time of day (private/, not in git) takes precedence
	[ -f "$theme/private/wallpapers/$phase.png" ] && target="$theme/private/wallpapers/$phase.png"
elif [ -f "$theme/wallpaper-rotate" ]; then
	# Rotate: interval in seconds, alphabetical order
	interval=$(grep -v '^#' "$theme/wallpaper-rotate" | head -1)
	set -- "$theme"/wallpapers/*.png
	# own images (private/, not in git) take precedence
	ls "$theme"/private/wallpapers/*.png >/dev/null 2>&1 && set -- "$theme"/private/wallpapers/*.png
	if [ -f "$1" ] && [ "${interval:-0}" -gt 0 ]; then
		i=$(( ($(date +%s) / interval) % $# + 1 ))
		eval "target=\${$i}"
	fi
fi
# Own wallpaper (private/, not in git) takes precedence; as PNG so hyprpaper reads it reliably
for f in "$theme"/private/wallpaper.png "$theme"/private/wallpaper.jpg "$theme"/private/wallpaper.jpeg "$theme"/private/wallpaper.webp; do
	[ -f "$f" ] || continue
	conv="$state/private-$(basename "$(readlink -f "$theme")").png"
	if [ ! -f "$conv" ] || [ "$f" -nt "$conv" ]; then
		python3 -I -c 'import sys; from PIL import Image; Image.open(sys.argv[1]).convert("RGB").save(sys.argv[2])' "$f" "$conv" || continue
	fi
	target=$conv
	break
done
target=$(readlink -f "$target")

link="$state/wallpaper.png"
[ "$(readlink "$link" 2>/dev/null)" = "$target" ] && exit 0
ln -sfn "$target" "$link"
if [ "${1:-}" != "--no-reload" ] && systemctl --user is-active -q hyprpaper.service; then
	systemctl --user restart hyprpaper.service
fi
