#!/bin/sh
# Run once with sudo: afterwards the login screen (sysc-greet) follows the
# desktop theme, and `theme` no longer needs root.
#   sudo ~/.config/bin/greeter-setup
# Does:
#  1. create /var/lib/sysc-greet/{themes,shell-theme}/, owner = calling user,
#     readable for the greeter user
#  2. link /var/lib/greeter/.config/sysc-greet/themes -> /var/lib/sysc-greet/themes
#     (where sysc-greet looks for its own themes)
#  3. remove the fixed "--theme tokyo-night" from /etc/greetd/hyprland-greeter-config.lua
#     (backup: .bak-theme), otherwise it always wins
#  4. apply the current desktop theme right away
set -eu
user=${SUDO_USER:-}
if [ "$(id -u)" -ne 0 ] || [ -z "$user" ]; then
	echo "Please run with sudo: sudo $0" >&2
	exit 1
fi
home=$(getent passwd "$user" | cut -d: -f6)
base=/var/lib/sysc-greet

install -d -m 755 "$base"
install -d -o "$user" -m 755 "$base/themes" "$base/shell-theme"

gdir=/var/lib/greeter/.config/sysc-greet
install -d -o greeter -g greeter -m 755 "$gdir"
if [ -L "$gdir/themes" ]; then
	:
elif [ -e "$gdir/themes" ]; then
	mv "$gdir/themes" "$gdir/themes.bak-$(date +%Y%m%d)"
	echo "Existing greeter themes backed up: $gdir/themes.bak-$(date +%Y%m%d)"
fi
ln -sfn "$base/themes" "$gdir/themes"

lua=/etc/greetd/hyprland-greeter-config.lua
if grep -q -- " --theme tokyo-night" "$lua"; then
	cp -a "$lua" "$lua.bak-theme"
	sed -i 's/ --theme tokyo-night//' "$lua"
	echo "Fixed greeter theme removed ($lua, backup: $lua.bak-theme)"
fi

su -s /bin/sh "$user" -c "$home/.config/bin/theme-greeter"
echo "Done. From the next start the login screen shows: $(cat "$base/shell-theme/theme" 2>/dev/null || echo '?')"
