# shellcheck shell=bash
# Bash config from the dotfiles repo. ~/.bashrc only loads this file (theme-setup adds that).
# Machine-specific parts are only set if they exist on the machine, so the same file
# works on desktop and laptop.

[[ $- != *i* ]] && return

# Prepend a directory to PATH if it exists and is not in it yet (no duplicates)
path_prepend() { [[ -d $1 && ":$PATH:" != *":$1:"* ]] && PATH="$1:$PATH"; }

alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
PS1='[\u@\h \W]\$ '

# Ctrl+S/Ctrl+Q not as terminal flow control (Ctrl+S would freeze the output)
stty -ixon 2>/dev/null

# ssh-agent as a systemd user service (ssh-agent.socket)
[[ -S $XDG_RUNTIME_DIR/ssh-agent.socket ]] && export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"

# Own scripts (bin/ is linked there), Rust, Bun
path_prepend "$HOME/.local/bin"
path_prepend "$HOME/.cargo/bin"
path_prepend "$HOME/.bun/bin"

# Java and Android SDK (Android Studio)
[[ -d /usr/lib/jvm/java-21-openjdk ]] && export JAVA_HOME=/usr/lib/jvm/java-21-openjdk/
if [[ -d $HOME/Android/Sdk ]]; then
	export ANDROID_HOME=$HOME/Android/Sdk
	export ANDROID_SDK_ROOT=$ANDROID_HOME
	export ANDROID_AVD_HOME=$HOME/.config/.android/avd/
	path_prepend "$ANDROID_HOME/emulator"
	path_prepend "$ANDROID_HOME/platform-tools"
	path_prepend "$ANDROID_HOME/cmdline-tools/latest/bin"
fi
export PATH

# History: 100,000 instead of 500 commands, no duplicates (leading space = do not save).
# Every command is appended right away and new lines from other terminals are read,
# so all open terminals share one history.
HISTSIZE=100000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend
PROMPT_COMMAND="history -a; history -n${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

# fzf: Ctrl+R fuzzy history search, Ctrl+T insert a file, Alt+C change into a directory
command -v fzf >/dev/null && eval "$(fzf --bash)"

# theme <Tab>: available themes (folders with palette.lua)
_theme_complete() {
	local d themes=()
	for d in "${XDG_CONFIG_HOME:-$HOME/.config}"/themes/*/palette.lua; do
		d=${d%/palette.lua}
		themes+=("${d##*/}")
	done
	mapfile -t COMPREPLY < <(compgen -W "${themes[*]}" -- "${COMP_WORDS[COMP_CWORD]}")
}
complete -F _theme_complete theme
