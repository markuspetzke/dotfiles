# shellcheck shell=bash
# Bash-Config aus dem Dotfiles-Repo. ~/.bashrc laedt nur diese Datei (theme-setup traegt das ein).
# Rechnerspezifisches wird nur gesetzt, wenn es auf dem Rechner existiert, damit dieselbe Datei
# auf Desktop und Laptop passt.

[[ $- != *i* ]] && return

# Verzeichnis vorne in PATH, falls es existiert und noch nicht drin ist (keine Duplikate)
path_prepend() { [[ -d $1 && ":$PATH:" != *":$1:"* ]] && PATH="$1:$PATH"; }

alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
PS1='[\u@\h \W]\$ '

# Strg+S/Strg+Q nicht als Terminal-Flusssteuerung (Strg+S friert sonst die Ausgabe ein)
stty -ixon 2>/dev/null

# ssh-agent als systemd-User-Dienst (ssh-agent.socket)
[[ -S $XDG_RUNTIME_DIR/ssh-agent.socket ]] && export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"

# Eigene Skripte (bin/ ist dorthin verlinkt), Rust, Bun
path_prepend "$HOME/.local/bin"
path_prepend "$HOME/.cargo/bin"
path_prepend "$HOME/.bun/bin"

# Java und Android-SDK (Android Studio)
[[ -d /usr/lib/jvm/java-21-openjdk ]] && export JAVA_HOME=/usr/lib/jvm/java-21-openjdk/
if [[ -d $HOME/Android/Sdk ]]; then
	export ANDROID_HOME=$HOME/Android/Sdk
	export ANDROID_SDK_ROOT=$ANDROID_HOME
	export ANDROID_AVD_HOME=$HOME/.config/.android/avd/
	path_prepend "$ANDROID_HOME/emulator"
	path_prepend "$ANDROID_HOME/platform-tools"
	path_prepend "$ANDROID_HOME/cmdline-tools/latest/bin"
fi
export PATH

# Verlauf: 100.000 statt 500 Befehle, ohne Duplikate (Leerzeichen am Anfang = nicht speichern).
# Jeder Befehl wird sofort angehaengt und neue Zeilen anderer Terminals eingelesen,
# so teilen sich alle offenen Terminals einen Verlauf.
HISTSIZE=100000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend
PROMPT_COMMAND="history -a; history -n${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

# fzf: Strg+R Verlauf unscharf durchsuchen, Strg+T Datei einfuegen, Alt+C in Ordner wechseln
command -v fzf >/dev/null && eval "$(fzf --bash)"

# theme <Tab>: vorhandene Themes (Ordner mit palette.lua)
_theme_complete() {
	local d themes=()
	for d in "${XDG_CONFIG_HOME:-$HOME/.config}"/themes/*/palette.lua; do
		d=${d%/palette.lua}
		themes+=("${d##*/}")
	done
	mapfile -t COMPREPLY < <(compgen -W "${themes[*]}" -- "${COMP_WORDS[COMP_CWORD]}")
}
complete -F _theme_complete theme
