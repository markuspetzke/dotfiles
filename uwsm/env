# Sourced by uwsm at session start and exported to Hyprland and systemd --user.

# Electron apps (Discord, VS Code, ...) natively on Wayland instead of XWayland.
export ELECTRON_OZONE_PLATFORM_HINT=auto

# Force the hardware profile if battery detection gets it wrong (desktop|laptop).
# export HYPR_PROFILE=laptop

# Cursor (Wii Pointer, lives in ~/.local/share/icons; variants P1-P4 = player colors).
export XCURSOR_THEME=Wii-Pointer-P1
export XCURSOR_SIZE=24
