// Office (Dunder Mifflin Scranton): rooms, quitting-time counter with a quote in the tooltip.
{
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "Reception",
            "2": "Michael's Office",
            "3": "Conference Room",
            "4": "Warehouse",
            "default": "Annex"
        }
    },
    "hyprland/window": {
        "format": "{title}"
    },
    "custom/uptime": {
        "exec": "~/.config/themes/office/quitting-time.sh",
        "return-type": "json",
        "interval": 60,
        "tooltip": true
    },
    "clock": {
        "format": "{:%a %d.%m.  %H:%M}",
        "calendar": {
            "format": {
                "months": "<span color='#e6dfcf'><b>{}</b></span>",
                "days": "<span color='#e6dfcf'>{}</span>",
                "weeks": "<span color='#8d8778'><b>W{}</b></span>",
                "weekdays": "<span color='#5b8ad0'><b>{}</b></span>",
                "today": "<span color='#f2d64b'><b><u>{}</u></b></span>"
            }
        },
        "tooltip-format": "<b>Dunder Mifflin · Scranton</b>\n<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },
    // Noto Sans has a narrow space and the Nerd Font icons are wider than their advance:
    // two spaces between icon and number, otherwise they touch
    "backlight": {
        "format": "{icon}  {percent}%"
    },
    "battery": {
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "󰚥  {capacity}%"
    },
    "cpu": {
        "format": "󰘚  {usage}%"
    },
    "memory": {
        "format": "󰍛  {percentage}%"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%"
    }
}
