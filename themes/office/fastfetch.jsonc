// fastfetch -- Office: employee ID with a coffee mug (logo: fastfetch-logo.txt).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/theme-current/fastfetch-logo.txt",
    "color": {
      "1": "38;2;230;223;207",
      "2": "38;2;160;112;74",
      "3": "38;2;141;135;120",
      "4": "38;2;61;68;80"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "showErrors": false,
    "color": {
      "keys": "38;2;91;138;208",
      "title": "38;2;91;138;208",
      "output": "38;2;230;223;207",
      "separator": "38;2;138;133;122"
    },
    "key": {
      "width": 15
    },
    "size": {
      "binaryPrefix": "iec",
      "ndigits": 1
    },
    "percent": {
      "type": [
        "num",
        "bar"
      ],
      "color": {
        "green": "38;2;79;125;50",
        "yellow": "38;2;168;120;28",
        "red": "38;2;192;57;43"
      }
    },
    "bar": {
      "width": 10,
      "char": {
        "elapsed": "■",
        "total": "□"
      },
      "border": {
        "left": "",
        "right": ""
      },
      "color": {
        "total": "38;2;79;86;100"
      }
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "DUNDER MIFFLIN · EMPLOYEE ID",
      "outputColor": "38;2;242;214;75"
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "38;2;61;68;80"
    },
    {
      "type": "title",
      "key": "Name",
      "format": "{user-name}"
    },
    {
      "type": "title",
      "key": "Workstation",
      "format": "{host-name}"
    },
    {
      "type": "custom",
      "key": "Branch",
      "format": "Scranton, PA"
    },
    {
      "type": "custom",
      "key": "Position",
      "format": "Assistant to the Regional Manager"
    },
    {
      "type": "os",
      "key": "Department",
      "format": "{pretty-name}"
    },
    {
      "type": "uptime",
      "key": "On duty for"
    },
    {
      "type": "packages",
      "key": "Files"
    },
    "break",
    {
      "type": "wm",
      "key": "Desk",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminal",
      "key": "Typewriter",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": "Dictaphone",
      "format": "{pretty-name} {version}"
    },
    "break",
    {
      "type": "cpu",
      "key": "Calculator",
      "format": "{name} ({cores-logical})",
      "temp": false
    },
    {
      "type": "gpu",
      "key": "Graphics",
      "format": "{name}",
      "hideType": "integrated",
      "driverSpecific": false
    },
    {
      "type": "memory",
      "key": "Memory",
      "format": "{percentage-bar}  {used} / {total}"
    },
    {
      "type": "disk",
      "key": "Filing cabinet",
      "folders": "/",
      "format": "{size-percentage-bar}  {size-used} / {size-total}"
    },
    {
      "type": "battery",
      "key": "Battery"
    },
    "break",
    {
      "type": "command",
      "key": "Quote",
      "keyColor": "38;2;242;214;75",
      "text": "shuf -n1 ~/.config/themes/office/quotes.txt"
    }
  ]
}
