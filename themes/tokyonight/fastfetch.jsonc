// Tokyo Night: fastfetch wie vor den Retro-Themes (Standardausgabe, ohne lokale IP).
// Die Module stehen ausdruecklich da: Eine Config ohne "modules" zeigt seit fastfetch 2.70 nur das Logo.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "theme",
    "icons",
    "cursor",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "locale",
    "break",
    "colors"
  ]
}
