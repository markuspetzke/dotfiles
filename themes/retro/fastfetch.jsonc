// fastfetch -- Bernstein-CRT, gleiche Palette wie hypr/theme.lua.
// Logo: gestreifte Sonne aus dem Wallpaper (logo.txt, $1-$4 = Farben unten).
// Nur Module mit Inhalt; was auf einem Rechner nichts findet (z. B. Akku am Desktop),
// wird ausgeblendet (showErrors = false). Keine lokale IP, damit Screenshots harmlos sind.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/theme-current/fastfetch-logo.txt",
    "color": {
      "1": "38;2;232;163;61", // Bernstein
      "2": "38;2;217;122;58", // Orange
      "3": "38;2;200;85;61", // Ziegelrot
      "4": "38;2;143;154;91" // Oliv
    },
    "padding": { "top": 1, "left": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "showErrors": false,
    "color": {
      "keys": "38;2;232;163;61",
      "title": "38;2;232;163;61",
      "output": "38;2;230;220;195",
      "separator": "38;2;138;131;112"
    },
    "key": { "width": 10 },
    "size": { "binaryPrefix": "iec", "ndigits": 1 },
    "percent": {
      "type": ["num", "bar"],
      "color": { "green": "38;2;143;154;91", "yellow": "38;2;232;163;61", "red": "38;2;200;85;61" }
    },
    "bar": {
      "width": 10,
      "char": { "elapsed": "█", "total": "░" },
      "border": { "left": "", "right": "" },
      "color": { "total": "38;2;90;85;70" }
    }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "separator", "string": "─", "outputColor": "38;2;54;51;43" },
    { "type": "os", "key": "os", "format": "{pretty-name} {arch}" },
    { "type": "kernel", "key": "kernel", "format": "{release}" },
    { "type": "uptime", "key": "uptime" },
    { "type": "packages", "key": "pakete" },
    "break",
    { "type": "wm", "key": "wm", "format": "{pretty-name} {version}" },
    { "type": "terminal", "key": "terminal", "format": "{pretty-name}" },
    { "type": "shell", "key": "shell", "format": "{pretty-name} {version}" },
    { "type": "display", "key": "display", "format": "{width}x{height} @ {refresh-rate} Hz" },
    "break",
    { "type": "cpu", "key": "cpu", "format": "{name} ({cores-logical})", "temp": false },
    { "type": "gpu", "key": "gpu", "format": "{name}", "hideType": "integrated", "driverSpecific": false },
    { "type": "memory", "key": "ram", "format": "{percentage-bar}  {used} / {total}" },
    { "type": "disk", "key": "disk", "folders": "/", "format": "{size-percentage-bar}  {size-used} / {size-total}" },
    { "type": "battery", "key": "akku" },
    "break",
    {
      "type": "colors",
      "symbol": "block",
      "paddingLeft": 0,
      "block": { "range": [0, 7] }
    }
  ]
}
