// Amber CRT: only overrides of waybar/modules.jsonc. Included first,
// Waybar merges the objects (the first file wins).
{
    "clock": {
        "calendar": {
            "format": {
                "months": "<span color='#e6dcc3'><b>{}</b></span>",
                "days": "<span color='#e6dcc3'>{}</span>",
                "weeks": "<span color='#8a8370'><b>W{}</b></span>",
                "weekdays": "<span color='#8f9a5b'><b>{}</b></span>",
                "today": "<span color='#e8a33d'><b><u>{}</u></b></span>"
            }
        }
    },
    "cpu": {
        "format": "CPU {icon}",
        "format-icons": [
            "▯▯▯▯▯",
            "▮▯▯▯▯",
            "▮▮▯▯▯",
            "▮▮▮▯▯",
            "▮▮▮▮▯",
            "▮▮▮▮▮"
        ],
        "tooltip-format": "CPU {usage}% · Last {load}"
    },
    "memory": {
        "format": "MEM {icon}",
        "format-icons": [
            "▯▯▯▯▯",
            "▮▯▯▯▯",
            "▮▮▯▯▯",
            "▮▮▮▯▯",
            "▮▮▮▮▯",
            "▮▮▮▮▮"
        ]
    },
    "pulseaudio": {
        "format": "VOL {icon}",
        "format-muted": "VOL -----",
        "format-icons": {
            "headphone": [
                "▯▯▯▯▯",
                "▮▯▯▯▯",
                "▮▮▯▯▯",
                "▮▮▮▯▯",
                "▮▮▮▮▯",
                "▮▮▮▮▮"
            ],
            "headset": [
                "▯▯▯▯▯",
                "▮▯▯▯▯",
                "▮▮▯▯▯",
                "▮▮▮▯▯",
                "▮▮▮▮▯",
                "▮▮▮▮▮"
            ],
            "default": [
                "▯▯▯▯▯",
                "▮▯▯▯▯",
                "▮▮▯▯▯",
                "▮▮▮▯▯",
                "▮▮▮▮▯",
                "▮▮▮▮▮"
            ]
        },
        "tooltip-format": "{desc}: {volume}%"
    },
    "battery": {
        "format": "BAT {icon}",
        "format-charging": "BAT+{icon}",
        "format-plugged": "AC  {icon}",
        "format-icons": [
            "▯▯▯▯▯",
            "▮▯▯▯▯",
            "▮▮▯▯▯",
            "▮▮▮▯▯",
            "▮▮▮▮▯",
            "▮▮▮▮▮"
        ],
        "tooltip-format": "{capacity}% · {timeTo}"
    },
    "backlight": {
        "format": "LUM {icon}",
        "format-icons": [
            "▯▯▯▯▯",
            "▮▯▯▯▯",
            "▮▮▯▯▯",
            "▮▮▮▯▯",
            "▮▮▮▮▯",
            "▮▮▮▮▮"
        ]
    }
}
