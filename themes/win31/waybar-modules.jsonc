// Windows 3.1: only overrides of waybar/modules.jsonc. Included first,
// Waybar merges the objects (the first file wins).
{
    "clock": {
        "calendar": {
            "format": {
                "months": "<span color='#000000'><b>{}</b></span>",
                "days": "<span color='#000000'>{}</span>",
                "weeks": "<span color='#606060'><b>W{}</b></span>",
                "weekdays": "<span color='#008000'><b>{}</b></span>",
                "today": "<span color='#000080'><b><u>{}</u></b></span>"
            }
        }
    }
}
