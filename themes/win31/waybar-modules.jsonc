// Windows-3.1: nur Abweichungen von waybar/modules.jsonc. Wird zuerst eingebunden,
// Waybar fuehrt die Objekte zusammen (erste Datei gewinnt).
{
    "clock": {
        "calendar": {
            "format": {
                "months": "<span color='#000000'><b>{}</b></span>",
                "days": "<span color='#000000'>{}</span>",
                "weeks": "<span color='#606060'><b>KW{}</b></span>",
                "weekdays": "<span color='#008000'><b>{}</b></span>",
                "today": "<span color='#000080'><b><u>{}</u></b></span>"
            }
        }
    }
}
