// Windows XP: taskbar at the bottom without gaps, start button, notification area with icons only,
// clock in the English 12-hour format. An empty "format" hides a module.
{
    "position": "bottom",
    "custom/start": {
        "exec": "echo start",
        "interval": "once",
        "tooltip": false,
        "on-click": "~/.config/bin/menu"
    },
    "clock": {
        "format": "{:%I:%M %p}",
        "calendar": {
            "format": {
                "months": "<span color='#000000'><b>{}</b></span>",
                "days": "<span color='#000000'>{}</span>",
                "weeks": "<span color='#7a7a7a'><b>W{}</b></span>",
                "weekdays": "<span color='#0054e3'><b>{}</b></span>",
                "today": "<span color='#e04343'><b><u>{}</u></b></span>"
            }
        },
        "locale": "en_US.UTF-8",
        "format-alt": "{:%A, %B %d, %Y}"
    },
    "spacing": 0,
    "hyprland/window": {
        "format": ""
    },
    // Hidden in the taskbar; the long interval also stops their polling.
    "cpu": {
        "format": "",
        "interval": 3600
    },
    "memory": {
        "format": "",
        "interval": 3600
    },
    "temperature": {
        "format": "",
        "interval": 3600
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "tooltip-format": "{desc}: {volume}%"
    }
}
