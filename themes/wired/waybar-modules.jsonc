// Wired: only overrides of waybar/modules.jsonc. Included first,
// Waybar merges the objects (the first file wins).
{
    "hyprland/window": {
        "format": "> {title}"
    },
    "hyprland/workspaces": {
        "format": "0{name}"
    },
    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "VOL --"
    },
    "network": {
        "format-ethernet": "NET ▂▄▆█",
        "format-linked": "NET ▂___",
        "format-disconnected": "NET ____"
    },
    "cpu": {
        "format": "CPU {usage}%"
    },
    "memory": {
        "format": "MEM {percentage}%"
    },
    "temperature": {
        "format": "TMP {temperatureC}°C"
    },
    "clock": {
        "format": "{:%H:%M:%S}",
        "interval": 1,
        "format-alt": "{:%Y-%m-%d}",
        "calendar": {
            "format": {
                "months": "<span color='#c9d6c3'><b>{}</b></span>",
                "days": "<span color='#c9d6c3'>{}</span>",
                "weeks": "<span color='#6f7d6b'><b>W{}</b></span>",
                "weekdays": "<span color='#9d84d8'><b>{}</b></span>",
                "today": "<span color='#7fd88f'><b><u>{}</u></b></span>"
            }
        }
    },
    "custom/uptime": {
        "exec": "awk '{s=int($1); printf \"CONNECTED %02d:%02d\\n\", s/3600, (s%3600)/60}' /proc/uptime",
        "interval": 60,
        "tooltip": false
    },
    "battery": {
        "format": "BAT {capacity}%",
        "format-charging": "BAT+ {capacity}%",
        "format-plugged": "AC {capacity}%"
    },
    "backlight": {
        "format": "LUM {percent}%"
    },
    "bluetooth": {
        "format": "BT",
        "format-disabled": "BT --",
        "format-connected": "BT {num_connections}"
    },
    "network#wifi": {
        "format-wifi": "NET {icon}",
        "format-icons": [
            "▂___",
            "▂▄__",
            "▂▄▆_",
            "▂▄▆█",
            "▂▄▆█"
        ],
        "format-disconnected": "NET ____"
    }
}
